@model student.Models.ProjectMeeting

@{
    ViewData["Title"] = Model.ProjectMeetingId == 0 ? "Add Project Meeting" : "Edit Project Meeting";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="AddEdit" method="post">
    <input type="hidden" asp-for="ProjectMeetingId" />

    <div class="mb-3">
        <label asp-for="ProjectGroupId" class="form-label"></label>
        <input asp-for="ProjectGroupId" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="GuideStaffId" class="form-label"></label>
        <input asp-for="GuideStaffId" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="MeetingPurpose" class="form-label"></label>
        <input asp-for="MeetingPurpose" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="MeetingDateTime" class="form-label"></label>
        <input asp-for="MeetingDateTime" type="datetime-local" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="MeetingLocation" class="form-label"></label>
        <input asp-for="MeetingLocation" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="MeetingStatus" class="form-label"></label>
        <input asp-for="MeetingStatus" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="MeetingNotes" class="form-label"></label>
        <textarea asp-for="MeetingNotes" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="ProjectMeetingList" class="btn btn-secondary">Cancel</a>
</form>
