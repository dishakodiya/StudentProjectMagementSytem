@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Project Meetings List";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-action="ProjectMeetingAddEdit" class="btn btn-primary">Add New Meeting</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Project Group</th>
            <th>Guide Staff</th>
            <th>Date & Time</th>
            <th>Purpose</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var meeting in Model)
        {
            <tr>
                <td>@meeting.ProjectGroupName</td>
                <td>@meeting.GuideStaffName</td>
                <td>@((DateTime)meeting.MeetingDateTime).ToString("yyyy-MM-dd HH:mm")</td>
                <td>@meeting.MeetingPurpose</td>
                <td>@meeting.MeetingStatus</td>
                <td>
                    <a asp-action="ProjectMeetingAddEdit" asp-route-id="@meeting.ProjectMeetingId" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@meeting.ProjectMeetingId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
