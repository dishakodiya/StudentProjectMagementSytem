@model IEnumerable<student.Models.ProjectMeeting>

@{
    ViewData["Title"] = "Project Meeting List";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container">
    <div class="card shadow-lg rounded-4">
        <div class="card-header bg-primary text-white text-center rounded-top-4">
            <h3 class="text-white">@ViewData["Title"]</h3>
        </div>
    </div>
</div>

<div class="container mt-5">
    <div class="card shadow-lg rounded-4">
        <div class="card-body">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold">All Scheduled Meetings</h5>
                <a asp-action="AddEdit" class="btn btn-success px-3">
                    <i class="fa fa-plus me-2"></i> Add New Meeting
                </a>
            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-warning">No project meetings found.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle shadow-sm">
                        <thead class="table-primary text-center">
                            <tr>
                                <th>ID</th>
                                <th>Project Group</th>
                                <th>Guide Staff</th>
                                <th>Purpose</th>
                                <th>Date/Time</th>
                                <th>Location</th>
                                <th>Notes</th>
                                <th>Status</th>
                                <th>Description</th>
                                <th>Actions</th>
                                <th>Attendance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.ProjectMeetingId</td>
                                    <td>@item.ProjectGroupName</td>
                                    <td>@item.GuideStaffName</td>
                                    <td>@item.MeetingPurpose</td>
                                    <td>@item.MeetingDateTime.ToString("g")</td>
                                    <td>@item.MeetingLocation</td>
                                    <td>@item.MeetingNotes</td>
                                    <td>@item.MeetingStatus</td>
                                    <td>@item.Description</td>
                                    <td class="text-center">
                                        <a asp-action="AddEdit" asp-route-id="@item.ProjectMeetingId" 
                                           class="btn btn-warning btn-sm me-2">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ProjectMeetingId" 
                                           class="btn btn-danger btn-sm"
                                           onclick="return confirm('Are you sure you want to delete this meeting?');">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="AttendenceMark" 
                                           asp-route-meetingId="@item.ProjectMeetingId" 
                                           asp-route-projectGroupId="@item.ProjectGroupId" 
                                           class="btn btn-primary btn-sm">
                                            <i class="fa fa-user-check me-1"></i> Mark
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
