@model student.Models.ProjectGroupMember
@{
    ViewData["Title"] = Model.ProjectGroupMemberId == 0 ? "Add Group Member" : "Edit Group Member";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="container">
    <div class="card shadow-lg rounded-4">
        <div class="card-header bg-primary text-white text-center rounded-top-4">
            <h3 class="text-white">@ViewData["Title"]</h3>
        </div>
    </div>
</div>

<div class="container mt-4">
    <div class="card shadow-lg p-4 rounded-4">
        <h3 class="text-primary mb-4">@ViewData["Title"]</h3>

        <form asp-action="ProjectGroupMemberAddEdit" method="post">
            <input type="hidden" asp-for="ProjectGroupMemberId" />

            <div class="mb-3">
                <label class="form-label">Project Group</label>
                <select asp-for="ProjectGroupId" class="form-select" required>
                    <option value="">-- Select Group --</option>
                    @foreach (var g in (IEnumerable<dynamic>)ViewBag.ProjectGroups)
                    {
                        <option value="@g.ProjectGroupId">@g.ProjectGroupName</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Student</label>
                <select asp-for="StudentId" class="form-select" required>
                    <option value="">-- Select Student --</option>
                    @foreach (var s in (IEnumerable<dynamic>)ViewBag.Students)
                    {
                        <option value="@s.StudentId">@s.StudentName</option>
                    }
                </select>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsGroupLeader" class="form-check-input" type="checkbox" />
                <label class="form-check-label">Is Group Leader</label>
            </div>

            <div class="mb-3">
                <label class="form-label">Student CGPA</label>
                <input asp-for="StudentCgpa" type="number" step="0.01" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control"></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a href="@Url.Action("ProjectGroupMemberList")" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
