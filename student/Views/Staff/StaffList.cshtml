@model IEnumerable<student.Models.AcdStaff>

@{
    ViewData["Title"] = "All staff";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container">
    <div class="card shadow-lg rounded-4">
        <div class="card-header bg-primary text-white text-center rounded-top-4">
            <h3 class="text-white">@ViewData["Title"]</h3>
        </div>
    </div>
</div>

<div class="container mt-5">
    <div class="card shadow-lg rounded-4">
        <div class="card-body">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                </div>
            }

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold">All Registered Staff</h5>
                <a class="btn btn-success px-3" asp-controller="Staff" asp-action="StaffAddEdit">
                    <i class="fa fa-plus me-2"></i> Add New Staff
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle shadow-sm">
                    <thead class="table-primary text-center">
                        <tr>
                            <th>Staff ID</th>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Description</th>
                            <th>Created</th>
                            <th>Modified</th>
                            <th style="width:130px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var staff in Model)
                            {
                                <tr class="text-center">
                                    <td>@staff.StaffId</td>
                                    <td>@staff.StaffName</td>
                                    <td>@staff.Phone</td>
                                    <td>@staff.Email</td>
                                    <td>@staff.Description</td>
                                    <td>@staff.Created.ToString("dd-MM-yyyy")</td>
                                    <td>@staff.Modified?.ToString("dd-MM-yyyy")</td>
                                    <td>
                                        <div class="d-flex justify-content-center">
                                            <a href="/Staff/StaffAddEdit/@staff.StaffId"
                                               class="btn btn-warning btn-sm me-2">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <a href="/Staff/StaffDelete/@staff.StaffId"
                                               onclick="return confirm('Are you sure you want to delete @staff.StaffName?');"
                                               class="btn btn-danger btn-sm">
                                                <i class="fa fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-3">
                                    No staff found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
