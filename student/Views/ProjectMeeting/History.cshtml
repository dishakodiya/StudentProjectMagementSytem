                        @model IEnumerable<student.Models.ProjectMeeting>

@{
    ViewData["Title"] = "Meeting History";
    Layout = "~/Views/Shared/_FacultyLayout.cshtml";
}

<div class="container">
    <div class="card shadow-lg rounded-4">
        <div class="card-header bg-secondary text-white text-center rounded-top-4">
            <h3 class="text-white">@ViewData["Title"]</h3>
        </div>
    </div>
</div>

<div class="container mt-5">
    <div class="card shadow-lg rounded-4">
        <div class="card-body">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            @if (Model != null && Model.Any())
            {
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold">Project Meeting History</h5>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle shadow-sm">
                        <thead class="table-secondary text-center">
                            <tr>
                                <th>Project Group</th>
                                <th>Guide</th>
                                <th>Meeting Date</th>
                                <th>Purpose</th>
                                <th>Location</th>
                                <th>Status</th>
                                <th>Notes</th>
                                <th>Status Description</th>
                                <th>Status Updated</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var meeting in Model)
                            {
                                <tr>
                                    <td>@meeting.ProjectGroupName</td>
                                    <td>@meeting.GuideStaffName</td>
                                    <td>@meeting.MeetingDateTime.ToString("dd-MMM-yyyy hh:mm tt")</td>
                                    <td>@meeting.MeetingPurpose</td>
                                    <td>@meeting.MeetingLocation</td>
                                    <td class="text-center">
                                        <span class="badge bg-@(meeting.MeetingStatus == "Completed" ? "success" :
                                                                meeting.MeetingStatus == "Cancelled" ? "danger" : "secondary")">
                                            @meeting.MeetingStatus
                                        </span>
                                    </td>
                                    <td>@meeting.MeetingNotes</td>
                                    <td>@meeting.MeetingStatusDescription</td>
                                    <td>@(meeting.MeetingStatusDatetime?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")</td>
                                    <td>@meeting.Description</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    No completed or cancelled meetings found.
                </div>
            }

        </div>
    </div>
</div>
