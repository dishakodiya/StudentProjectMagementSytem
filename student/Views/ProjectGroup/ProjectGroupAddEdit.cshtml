@model student.Models.AcdPrjProjectGroup

@{
    ViewData["Title"] = "Add/Edit Project Group";
    var staffList = ViewBag.StaffList as List<student.Models.AcdStaff>;
    var projectTypes = ViewBag.ProjectTypes as List<student.Models.AcdPrjProjectType>;
}

<div class="container mt-5">
    <h2 class="text-primary mb-4">@(Model.ProjectGroupId == 0 ? "Add New Project Group" : "Edit Project Group")</h2>

    <form asp-action="ProjectGroupAddEdit" method="post">
        <input type="hidden" asp-for="ProjectGroupId" />

        <div class="mb-3">
            <label asp-for="ProjectGroupName" class="form-label">Group Name</label>
            <input asp-for="ProjectGroupName" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="ProjectTypeId" class="form-label">Project Type</label>
            <select asp-for="ProjectTypeId" class="form-select">
                <option value="">-- Select Type --</option>
                @foreach (var type in projectTypes)
                {
                    <option value="@type.ProjectTypeId">@type.ProjectTypeName</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="ProjectTitle" class="form-label">Project Title</label>
            <input asp-for="ProjectTitle" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="ProjectArea" class="form-label">Project Area</label>
            <input asp-for="ProjectArea" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="GuideStaffId" class="form-label">Guide Staff</label>
            <select asp-for="GuideStaffId" class="form-select">
                <option value="">-- Select Guide --</option>
                @foreach (var s in staffList)
                {
                    <option value="@s.StaffId">@s.StaffName</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="ConvenerStaffId" class="form-label">Convener Staff</label>
            <select asp-for="ConvenerStaffId" class="form-select">
                <option value="">-- Select Convener --</option>
                @foreach (var s in staffList)
                {
                    <option value="@s.StaffId">@s.StaffName</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="ExpertStaffId" class="form-label">Expert Staff</label>
            <select asp-for="ExpertStaffId" class="form-select">
                <option value="">-- Select Expert --</option>
                @foreach (var s in staffList)
                {
                    <option value="@s.StaffId">@s.StaffName</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a href="@Url.Action("ProjectGroupList")" class="btn btn-secondary">Cancel</a>
    </form>
</div>
