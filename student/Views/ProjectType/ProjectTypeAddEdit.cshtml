@model student.Models.AcdPrjProjectType

@{
    ViewData["Title"] = Model.ProjectTypeId == 0 ? "Add Project Type" : "Edit Project Type";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";  // same layout as list page
}
<div class="container">
    <div class="card shadow-lg rounded-4">
        <div class="card-header bg-primary text-white text-center rounded-top-4">
            <h3 class="text-white">@ViewData["Title"]</h3>
        </div>
    </div>
</div>
<div class="container mt-5">
    <div class="card shadow-lg rounded-4">
        @* <div class="card-header bg-primary text-white text-center rounded-top-4">
            <h3 class="text-white mb-0">@ViewData["Title"]</h3>
        </div> *@
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="ProjectTypeAddEdit" asp-controller="ProjectType" method="post">
                <input type="hidden" asp-for="ProjectTypeId" />

                <div class="mb-3">
                    <label asp-for="ProjectTypeName" class="form-label fw-bold">Project Type Name</label>
                    <input asp-for="ProjectTypeName" class="form-control shadow-sm" placeholder="Enter project type name" required />
                    <span asp-validation-for="ProjectTypeName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Description</label>
                    <textarea asp-for="Description" class="form-control shadow-sm" rows="3" placeholder="Enter description"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="ProjectTypeList" asp-controller="ProjectType" class="btn btn-secondary px-3">
                        <i class="fa fa-arrow-left me-2"></i> Back to List
                    </a>

                    <button type="submit" class="btn btn-success px-4">
                        <i class="fa fa-save me-2"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
