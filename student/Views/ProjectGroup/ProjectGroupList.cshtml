@model IEnumerable<student.Models.AcdPrjProjectGroup>
@{
    ViewData["Title"] = "Project Group List";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<div class="container mt-5">
    <h2 class="mb-4 text-primary">Project Groups</h2>
    <a href="@Url.Action("ProjectGroupAddEdit", "ProjectGroup")" class="btn btn-success mb-3">+ Add New</a>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No project groups found.</div>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Project Title</th>
                    <th>Project Area</th>
                    <th>Type</th>
                    <th>Guide</th>
                    <th>Average CPI</th>
                            <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProjectGroupId</td>
                        <td>@item.ProjectGroupName</td>
                        <td>@item.ProjectTitle</td>
                        <td>@item.ProjectArea</td>
                        <td>@item.ProjectTypeName</td>
                        <td>@item.GuideStaffName</td>
                        <td>@item.AverageCpi?.ToString("0.00")</td>
                                <td>@item.Description</td>
                        <td>
                            <a href="@Url.Action("ProjectGroupAddEdit", new { id = item.ProjectGroupId })" class="btn btn-primary btn-sm">Edit</a>
                            <a href="@Url.Action("Delete", new { id = item.ProjectGroupId })" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure to delete?')">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
